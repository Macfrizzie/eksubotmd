# ==========================================
# 🤖 Eksu-MD Configuration Template
# ==========================================

# Bot Settings
PREFIX=.
BOT_NAME=Eksu-MD
MODE=public # 'public' or 'private'

# Phone Number for Pairing Code (Only needed for initial login if not using QR / SESSION_ID)
# Format: International format without symbols or plus, e.g. 2348012345678
PAIR_NUMBER=

# Owner Settings (Comma-separated phone numbers without '+' or spaces)
OWNER_NUMBERS=
OWNER_NAME=Owner
SUDO=

# Session Credentials (Auto-generated after first login)
SESSION_ID=

# Database Settings (Optional)
DATABASE_URL=

# GitHub Backup Settings (For autoreply gist backups)
ENABLE_GIST_BACKUP=false
AUTO_REPLY_GIST_ID=
GITHUB_GIST_TOKEN=

# Third-party APIs (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
ACRCLOUD_KEY=
ACRCLOUD_SECRET=
ACRCLOUD_HOST=
